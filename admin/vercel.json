{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "public": false,
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://stepd.stepai.kr/api/proxy/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
