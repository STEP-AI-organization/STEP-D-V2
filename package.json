{
  "name": "step-d",
  "version": "0.1.0",
  "private": true,
  "description": "STEP-D — UX-first studio (monorepo: web + server). Original STEPD is a separate read-only repo.",
  "scripts": {
    "setup:check": "node scripts/setup-check.mjs",
    "check": "pnpm -r typecheck && pnpm --filter stepaistudio test && pnpm --filter @stepd/server test && node scripts/test-core.mjs",
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @stepd/web dev",
    "dev:server": "pnpm --filter @stepd/server dev",
    "dev:native": "pnpm --filter stepaistudio dev",
    "build:native": "pnpm --filter stepaistudio build",
    "dist:native": "pnpm --filter stepaistudio dist",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter stepaistudio test && pnpm --filter @stepd/server test",
    "test:e2e": "pnpm --filter @stepd/server --fail-if-no-match test:e2e",
    "start": "pnpm -r --parallel start",
    "worker:naver": "pnpm --filter @stepd/server worker:naver",
    "lint": "pnpm --filter @stepd/web lint",
    "test:core": "node scripts/test-core.mjs"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.2"
}
