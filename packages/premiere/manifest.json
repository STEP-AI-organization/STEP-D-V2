{
  "id": "kr.stepai.stepd.premiere",
  "name": "STEP AI 스튜디오",
  "version": "0.1.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.6.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "stepd.studio",
      "label": { "default": "STEP AI 스튜디오" },
      "minimumSize": { "width": 320, "height": 420 },
      "preferredDockedSize": { "width": 440, "height": 700 },
      "preferredFloatingSize": { "width": 560, "height": 780 }
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["generic"]
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["https://stepd.stepai.kr", "https://storage.googleapis.com"]
    },
    "localFileSystem": "request",
    "allowCodeGenerationFromStrings": false,
    "webview": {
      "allow": "yes",
      "domains": ["https://stepd.stepai.kr"],
      "enableMessageBridge": "localAndRemote"
    }
  }
}
