{
  "id": "kr.stepai.stepd.premiere",
  "name": "STEP-D",
  "version": "0.1.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.6.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "stepd.upload",
      "label": { "default": "STEP-D 업로드" },
      "minimumSize": { "width": 260, "height": 320 },
      "preferredDockedSize": { "width": 320, "height": 520 },
      "preferredFloatingSize": { "width": 360, "height": 600 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["https://stepd.stepai.kr", "https://storage.googleapis.com"]
    },
    "localFileSystem": "request",
    "allowCodeGenerationFromStrings": false
  }
}
