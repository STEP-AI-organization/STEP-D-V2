# core/ — keep source (*.py, *.ts, *.md, requirements.txt) only.
# Input media and generated artifacts stay out of git.

# Input videos / extracted audio
*.mp4
*.wav
*.m4a
*.webm

# Generated transcripts / subtitles
*.srt
*.vtt
*.ass

# Scene detection artifacts
scenes.json
scene_frames/
*.jpg
*.jpeg
*.png

# Pipeline outputs
pipeline_output.json
whisperx_result*.json
refined_*.json
shorts.json
analysis.json
test_transcript.srt

# Python
__pycache__/
*.pyc
.venv*/

# MediaPipe/TFLite model weights. `python -m core.reframe.download_model` regenerates it.
.models/
