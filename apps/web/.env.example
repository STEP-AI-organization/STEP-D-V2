# apps/web 환경변수 — 실제 코드가 읽는 건 이거 하나뿐이다 (2026-08-06 실측)
# .env.local 로 복사해서 쓴다.
#
# 로컬     : 로컬 서버 직접 호출        → http://localhost:4100/api
# 프로덕션 : Vercel 프록시 경유(ID토큰) → /api/proxy/api
# ⚠️ 프로덕션에서 이 값이 비면 화면 전체가 "서버 미연결" 이 된다.
#
# NEXT_PUBLIC_API_BASE_URL / NEXT_PUBLIC_API_PROXY / API_PROXY_TARGET 은
# 구 STEPD 잔재라 아무데서도 읽지 않는다 (2026-08-06 제거).
NEXT_PUBLIC_API_URL=http://localhost:4100/api
