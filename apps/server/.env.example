# apps/server 환경변수 — 실제 코드가 읽는 것 전부 (2026-08-06 실측)
# .env 로 복사해 값만 채운다. 기본값이 있는 항목은 바꿀 때만 적을 것.
# 로드 경로: package.json dev/start = --env-file .env · worker:prod = .env.worker

# ── 필수 ────────────────────────────────────────────────
DATABASE_URL=                 # 없으면 DB 초기화 실패
PORT=4100                     # Cloud Run 은 8080 주입 (cloudbuild 에서 설정 금지)
NODE_ENV=development

# 스토리지: GCS_BUCKET 이 있으면 GCS 모드, 없으면 STEPD_STORAGE_DIR 로컬 모드
GCS_BUCKET=
STEPD_STORAGE_DIR=

# ── core 파이썬 파이프라인 (워커) ─────────────────────────
# CORE_DIR / CORE_PYTHON 은 리포 구조에서 자동 유도된다 (<repo>/core, core/.venv310).
# venv 위치가 다를 때만 지정.
# CORE_DIR=
# CORE_PYTHON=
# REFRAME_FACE_MODEL=                  # MediaPipe .tflite; worker image includes a verified model
# REFRAME_PIPELINE_VERSION=vision-safety-v1  # bump to invalidate stored AI plans
# REFRAME_TIMEOUT_MIN=20
# GOOGLE_CLOUD_PROJECT=step-d          (코드 기본값)
# VERTEX_LOCATION=asia-northeast3      (코드 기본값)
GOOGLE_APPLICATION_CREDENTIALS=        # 비우면 gcloud ADC

# ── STT / 화자분리 ──────────────────────────────────────
STT_PROVIDER=gemini           # gemini | hybrid | whisper(로컬 GPU, 프로덕션 아님)
SONIOX_API_KEY=               # hybrid 일 때 필수
HF_TOKEN=                     # pyannote 3.1 diarize. 없으면 speaker 비움
RUN_CHYRON_PER_SEG=1          # 0 = per-seg Vision rewrite 스킵.
                              # ⚠️ 60분 회차 원가의 51%(₩1,218)가 여기다 — 켜고 끄는 게 마진을
                              # 가른다(docs/ops/how-it-works.md §4). 로컬은 보통 0 으로 둔다.
RUN_REFINE=1
RUN_SPEAKER_POSTPROC=1

# ── Gemini 배치 모드 (원가 절반) ─────────────────────────
# chyron(회차 Gemini 콜의 83%)을 Vertex 배치 예측으로 돌린다 → 그 스테이지 단가 50%.
# ⚠️ 2026-08-17 실측: 단가는 정확히 절반(₩658→₩329)인데 **한 회차에 5시간 45분** 걸렸다
# (동기 4분). 지금 구현은 파이프라인이 기다리는 구조라 상한(25분)에서 취소→동기 폴백 —
# 느리면서 제값이다. 그래서 기본 0. 쓰려면 제출/수거 2단계로 바꿀 것.
GEMINI_BATCH=0                # 1 | true | on 만 켜짐. 오타·빈값은 OFF
GEMINI_BATCH_BUCKET=          # 비면 GCS_BUCKET 사용
# GEMINI_BATCH_START_TIMEOUT_SEC=420   # 큐 대기 상한 (넘기면 취소→동기)
# GEMINI_BATCH_TIMEOUT_SEC=1500        # 전체 상한

# ── OAuth ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=
META_APP_ID=                  # Meta 앱 기본 설정의 앱 ID (Facebook Page 전용)
META_APP_SECRET=
META_REDIRECT_URI=            # 없으면 PUBLIC_URL 기준 자동 조립
INSTAGRAM_APP_ID=             # ⚠️ 같은 앱이라도 "Instagram API" 제품 화면의 Instagram 앱 ID — META_APP_ID 와 다른 값
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=       # 없으면 PUBLIC_URL 기준 자동 조립
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# TIKTOK_UPLOAD_ENABLED=0     # 1 일 때만 받은함 드래프트 실업로드. 미설정·오타·빈값 = OFF(기록만)
# TIKTOK_DIRECT_POST=0        # 1 이면 받은함 드래프트 대신 채널에 **바로 게시**(video.publish).
                              # ⚠️ 틱톡 앱 심사 통과 + 계정 재연결이 선행 — 안 하면 OAuth 가 깨지거나
                              # SELF_ONLY(본인만 보기)로 강제된다 (upload-gate.ts 주석)

# ── 커머스 제휴 링크 (쿠팡파트너스) ──────────────────────
# 켜면 ① generate-metadata 가 상품 쿼리를 같이 뽑고(같은 호출 · 추가 원가 ₩0)
#      ② commerce.link 잡이 제휴 링크를 발급하고
#      ③ **YouTube 설명란에만** 링크 + 대가성 문구가 붙는다 (발행 조립 시점).
# ⚠️ 켤 때 commerce 레인 워커(WORKER_JOBS=commerce)도 같이 띄울 것 —
#    안 띄우면 잡이 아무도 안 집어 조용히 pending 으로 쌓인다.
# ⚠️ 그 워커 PC 에는 파트너스에 로그인된 전용 프로필 크롬이 떠 있어야 한다:
#    chrome.exe --remote-debugging-port=9223 --user-data-dir=%LOCALAPPDATA%\stepd\partners-chrome-profile
# COMMERCE_LINKS_ENABLED=0    # 1 일 때만 ON. 미설정·오타·빈값 = OFF
# COUPANG_CDP_URL=http://127.0.0.1:9223
# COUPANG_GAP_MS=1200         # 내부 API 연속 호출 간격 (저볼륨 전제)

# ── 썸네일 생성 ─────────────────────────────────────────
OPENAI_API_KEY=               # 없으면 이미지 생성 불가
REMOVEBG_API_KEY=             # 없으면 로컬 배경제거 폴백

# ── 선택 · 코드 기본값 있음 (주석의 값이 기본) ─────────────
# WORKER_JOBS=all             # 콤마구분 잡 이름으로 제한 가능
# CORE_ANALYZE_FAST=0
# CORE_ANALYZE_STALL_MIN=60   # 분
# AUTO_THUMBNAIL=0
# AUTO_GEBD=0                 # GCS_BUCKET 함께 있어야 동작
# GEMINI_MODEL=gemini-3.1-flash
# GEMINI_AUTOFILL_MODEL=      # 비면 GEMINI_MODEL
# QUERY_PARSE_MODEL=gemini-2.5-flash
# EMBED_MODEL=text-multilingual-embedding-002
# EMBED_DIM=768
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_PRO_MODEL=gpt-image-2
# REMUX_MAX_MB=512
# CHANNEL_PROFILE_MIN_CONF=0.75
# YOUTUBE_API_KEY=
# YOUTUBE_UPLOAD_ENABLED=0
# YT_DLP=yt-dlp
# YTDLP_COOKIES=              # 파일 경로. 있으면 yt-dlp --cookies 로 붙임
# GEBD_IMAGE=asia-northeast3-docker.pkg.dev/step-d/stepd/gebd-mmaction2:latest
# WORKER_VM_NAME=stepd-worker
# WORKER_VM_ZONE=asia-northeast3-c

# ── 콘텐츠 공장 (Factory API · docs/reference/factory-api.md) ──────────────
FACTORY_API_KEY=              # 없으면 Factory API 가 닫힌다(503). 외부 연동의 유일한 방어선
FACTORY_ENABLED=              # 킬 스위치. truthy 일 때만 ingest 수락
INTERNAL_API_BASE=            # 워커가 렌더 라우트를 부를 주소 (비면 PUBLIC_URL)
# FACTORY_DAILY_CAP=5                프로그램당 하루 자동 배포 상한
# FACTORY_HOURLY_LIMIT=20            시간당 ingest 상한 (사고 방지)
# FACTORY_PUBLICIZE_DELAY_MIN=10     private → public 전환 유예(분)
# FACTORY_RETURN_ORIGINS=            채널 연결 후 복귀할 외부 오리진 allowlist (쉼표 구분)
# FACTORY_ALLOWED_ORIGIN=            브라우저 직접 호출 시 CORS

# ── 결제 · 크레딧 (포트원 + KG이니시스) ─────────────────────────────────────
# 크레딧 1개 = 분석 1분. 선불 충전만 쓴다(월정액·구독은 만들지 않기로 함 · 2026-08-11).
CREDIT_PRICE_KRW=             # 크레딧 1개 판매가(원). 비면 결제창을 안 띄운다(0원 결제 방지)
# PUBLISH_CREDITS=3           # 배포 1건(영상×채널) 크레딧. 기본 3 · 0=배포 무과금 (실패 시 자동 환급)
PORTONE_API_SECRET=           # 서버 전용. **결제 실행 권한이 여기 있다** — 절대 브라우저로 안 나감
PORTONE_STORE_ID=             # 공개 식별자. 브라우저 SDK 에 그대로 넘어간다
PORTONE_WEBHOOK_SECRET=       # whsec_... · 웹훅 위조 방지

# ⚠️ 채널키가 **두 개**다. 포트원은 일반결제와 빌링(카드 저장)이 서로 다른 채널이라,
#    한쪽 키로 다른 쪽을 하려 들면 실패한다. 콘솔 → 결제연동 → 채널 관리에서 각각 복사.
PORTONE_CHANNEL_KEY=          # ① 일반결제(PC) — 결제창을 띄워 그 자리에서 긁는다
PORTONE_BILLING_CHANNEL_KEY=  # ② 정기결제(빌링) — 카드 저장 + 저장 카드로 서버가 긁는다
                              #    비면 카드 등록이 503 으로 막힌다(잘못된 채널로 시도하는 것보다 낫다)

# ── 인보이스(거래명세서) 발행자 = 우리 ──────────────────────────────────────
# ⚠️ 세금계산서가 아니다. 그건 국세청 신고가 필요해서 별도 발행 서비스(팝빌 등)를 붙여야 한다.
# 비어 있으면 문서에 "미설정"으로 찍힌다 — 없는 값을 지어내지 않는다.
# **고객사(공급받는 자) 사업자정보는 여기가 아니라 어드민 화면**에서 회사마다 입력한다.
INVOICE_ISSUER_NAME=          # 상호 (예: 주식회사 스텝에이아이)
INVOICE_ISSUER_BIZNO=         # 사업자등록번호 (하이픈 있어도 됨)
# INVOICE_ISSUER_ADDRESS=       사업장 주소 (선택)
# INVOICE_ISSUER_CONTACT=       담당자 연락처·이메일 (선택)

# ── 메일 발송 (인보이스 · 자동배포 완료 알림 — mailer.ts) ─────────────────────
# 미설정이면 조용히 건너뛴다(발송 실패가 결제·배포를 막지 않는다). 인증은 둘 중 하나:
#  ① 평문 SMTP:   SMTP_HOST + SMTP_USER + SMTP_PASS (+ SMTP_PORT · 기본 587)
#  ② Gmail OAuth: SMTP_USER + SMTP_OAUTH_* 3종 — 호스트·포트 생략 시 smtp.gmail.com:465.
#     ⚠️ refresh token 스코프가 https://mail.google.com/ 여야 SMTP 가 열린다
#        (gmail.send 만으로는 REST API 는 되지만 SMTP XOAUTH2 는 거절된다).
# 자동배포 알림은 **워커(stepd-worker-youtube)가 보낸다** — 서버에만 넣으면 인보이스만 나간다.
# SMTP_USER=hkj@stepai.kr
# SMTP_OAUTH_CLIENT_ID=
# SMTP_OAUTH_CLIENT_SECRET=
# SMTP_OAUTH_REFRESH_TOKEN=
# INVOICE_MAIL_FROM=            보낸이 표기 (기본 SMTP_USER)

# ── 인증 자세 ────────────────────────────────────────────────────────────────
# ⚠️ 테넌트가 둘 이상인데 AUTH_REQUIRED 가 꺼져 있으면 모든 요청이 기본 테넌트로 해석돼
#    격리가 무의미해진다 — 기동 시 assertAuthPosture() 가 막는다.
AUTH_REQUIRED=                # 1 이면 로그인 필수. 프로덕션은 1
# ALLOW_RLS_BYPASS=           테스트에서만. 운영에서 켜지 말 것
# INTERNAL_API_TOKEN=         내부 호출용 토큰

# ── 워커 ─────────────────────────────────────────────────────────────────────
# WORKER_JOBS 는 레인 선택 (content | youtube | gebd | naver | all) — 위 참조
# WORKER_MODE=drain           큐가 비면 종료(Cloud Run Jobs 용). 로컬은 비워둔다
# DRAIN_MAX_MS=3000000        drain 최대 실행시간(기본 50분). 넘으면 새 잡을 안 집는다
# AUTOMATION_CYCLE_MS=        자동화 주기

# ── GEBD (GPU 장면경계) ──────────────────────────────────────────────────────
# 로컬에서는 안 쓴다. GPU VM 전용 레인이다.
# GEBD_MODEL= / GEBD_MODEL_GCS= / GEBD_ASSETS=
# GEBD_CHUNK_SEC=300          청크 길이 · GEBD_CORES=1  GPU 병렬도(3060Ti 는 2가 안전)
# GEBD_VM_NAME= / GEBD_VM_ZONE=      /api/admin/gebd-vm/wake 대상

# ── 네이버 발행 (윈도우2 워커 전용) ──────────────────────────────────────────
# ⚠️ 게이트는 기본 OFF 다. 미설정·오타·빈값은 전부 OFF — 잘못된 env 의 실패 모드가
#    "업로드 안 됨" 이어야지 "실수로 업로드됨" 이면 안 된다.
NAVER_UPLOAD_ENABLED=         # 1 일 때만 실제 업로드
# NAVER_SESSION_KEY=          세션 암호화 키(base64 32바이트). **서버와 워커가 같아야 한다**
                              #   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NAVER_MIN_GAP_MS=60000      발행 간 최소 간격. 몰아넣으면 네이버가 불안정해진다(실측)
# NAVER_SESSION_DIR= / NAVER_SESSION_PATH=   세션 파일 위치(기본 ~/.stepd/naver)
# NAVER_WORK_DIR=             영상 임시 작업 폴더(회사/프로그램/회차로 갈린다)

# ── Canva (쇼츠 프레임 템플릿 동기화) ────────────────────────────────────────
# CANVA_CLIENT_ID= / CANVA_CLIENT_SECRET=    없으면 canva:sync 만 안 된다
