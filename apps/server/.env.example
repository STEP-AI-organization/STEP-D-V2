# apps/server 환경변수 — 실제 코드가 읽는 것 전부 (2026-08-06 실측)
# .env 로 복사해 값만 채운다. 기본값이 있는 항목은 바꿀 때만 적을 것.
# 로드 경로: package.json dev/start = --env-file .env · worker:prod = .env.worker

# ── 필수 ────────────────────────────────────────────────
DATABASE_URL=                 # 없으면 DB 초기화 실패
PORT=4100                     # Cloud Run 은 8080 주입 (cloudbuild 에서 설정 금지)
NODE_ENV=development

# 스토리지: GCS_BUCKET 이 있으면 GCS 모드, 없으면 STEPD_STORAGE_DIR 로컬 모드
GCS_BUCKET=
STEPD_STORAGE_DIR=

# ── core 파이썬 파이프라인 (워커) ─────────────────────────
# CORE_DIR / CORE_PYTHON 은 리포 구조에서 자동 유도된다 (<repo>/core, core/.venv310).
# venv 위치가 다를 때만 지정.
# CORE_DIR=
# CORE_PYTHON=
# GOOGLE_CLOUD_PROJECT=step-d          (코드 기본값)
# VERTEX_LOCATION=asia-northeast3      (코드 기본값)
GOOGLE_APPLICATION_CREDENTIALS=        # 비우면 gcloud ADC

# ── STT / 화자분리 ──────────────────────────────────────
STT_PROVIDER=gemini           # gemini | hybrid | whisper(로컬 GPU, 프로덕션 아님)
SONIOX_API_KEY=               # hybrid 일 때 필수
HF_TOKEN=                     # pyannote 3.1 diarize. 없으면 speaker 비움
RUN_CHYRON_PER_SEG=1          # 0 = per-seg Vision rewrite 스킵 (비용 절감)
RUN_REFINE=1
RUN_SPEAKER_POSTPROC=1

# ── OAuth ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=            # 없으면 PUBLIC_URL 기준 자동 조립
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# ── 썸네일 생성 ─────────────────────────────────────────
OPENAI_API_KEY=               # 없으면 이미지 생성 불가
REMOVEBG_API_KEY=             # 없으면 로컬 배경제거 폴백

# ── 선택 · 코드 기본값 있음 (주석의 값이 기본) ─────────────
# LAB_WRITE_TOKEN=            # 빈 값이면 Lab 매칭 쓰기 503
# WORKER_JOBS=all             # 콤마구분 잡 이름으로 제한 가능
# CORE_ANALYZE_FAST=0
# CORE_ANALYZE_STALL_MIN=60   # 분
# AUTO_THUMBNAIL=0
# AUTO_GEBD=0                 # GCS_BUCKET 함께 있어야 동작
# GEMINI_MODEL=gemini-3.1-flash
# GEMINI_AUTOFILL_MODEL=      # 비면 GEMINI_MODEL
# QUERY_PARSE_MODEL=gemini-2.5-flash
# EMBED_MODEL=text-multilingual-embedding-002
# EMBED_DIM=768
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_PRO_MODEL=gpt-image-2
# REMUX_MAX_MB=512
# CHANNEL_PROFILE_MIN_CONF=0.75
# YOUTUBE_API_KEY=
# YOUTUBE_UPLOAD_ENABLED=0
# YT_DLP=yt-dlp
# YTDLP_COOKIES=              # 파일 경로. 있으면 yt-dlp --cookies 로 붙임
# GEBD_IMAGE=asia-northeast3-docker.pkg.dev/step-d/stepd/gebd-mmaction2:latest
# WORKER_VM_NAME=stepd-worker
# WORKER_VM_ZONE=asia-northeast3-c
