{
  "name": "@stepd/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "STEP-D backend — Hono + node:sqlite + ffmpeg",
  "scripts": {
    "dev": "tsx watch --env-file .env src/index.ts",
    "start": "tsx --env-file .env src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"src/**/*.test.ts\"",
    "worker": "node --unhandled-rejections=warn --import tsx --env-file-if-exists=.env src/worker.ts",
    "worker:prod": "node --unhandled-rejections=warn --import tsx --env-file-if-exists=.env.worker src/worker.ts",
    "migrate": "node-pg-migrate --envPath .env --migrations-dir migrations --migrations-table pgmigrations --ignore-pattern \"(?!\\d{4}_.*\\.cjs$).*\"",
    "migrate:up": "pnpm migrate up",
    "migrate:down": "pnpm migrate down",
    "migrate:redo": "pnpm migrate redo",
    "migrate:create": "node scripts/create-migration.mjs",
    "migrate:status": "node --env-file-if-exists=.env scripts/migrate-status.mjs",
    "user:create": "node --import tsx --env-file .env scripts/create-user.mts",
    "tenants:report": "node --import tsx --env-file .env scripts/tenant-report.mts",
    "canva:sync": "node --import tsx --env-file .env scripts/sync-canva-templates.mts",
    "canva:push": "node --import tsx --env-file .env scripts/push-canva-template.mts",
    "naver:login": "node --import tsx --env-file-if-exists=.env scripts/naver-login.mts",
    "naver:probe": "node --import tsx --env-file-if-exists=.env scripts/naver-probe.mts",
    "naver:verify": "node --import tsx --env-file-if-exists=.env scripts/naver-form-verify.mts",
    "naver:categories": "node --import tsx --env-file-if-exists=.env scripts/naver-categories.mts",
    "naver:e2e-seed": "node --import tsx --env-file .env scripts/naver-e2e-seed.mts",
    "worker:naver": "node --unhandled-rejections=warn --import tsx --env-file-if-exists=.env scripts/worker-naver.mts",
    "worker:render": "node --unhandled-rejections=warn --import tsx --env-file-if-exists=.env scripts/worker-render.mts",
    "server:local": "node --unhandled-rejections=warn --import tsx --env-file-if-exists=.env src/index.ts",
    "naver:login:upload": "node --import tsx --env-file-if-exists=.env scripts/naver-login-upload.mts",
    "commerce:login": "node --import tsx --env-file-if-exists=.env scripts/commerce-login-upload.mts",
    "chatbot:ask": "node --import tsx --env-file .env scripts/chatbot-ask.mts",
    "eval:make": "node --import tsx scripts/make-evalset.mts",
    "eval:run": "node --import tsx --env-file .env scripts/run-evalset.mts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.15.0",
    "@hono/node-server": "^1.13.7",
    "@napi-rs/canvas": "^1.0.7",
    "fflate": "^0.8.3",
    "google-auth-library": "^9.15.0",
    "hono": "^4.6.14",
    "jspdf": "^4.2.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "node-pg-migrate": "^7.9.1",
    "playwright": "^1.62.1",
    "typescript": "^5"
  }
}
