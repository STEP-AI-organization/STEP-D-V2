# STEP-D 워커 이미지 — Cloud Run Jobs 용.
#
# 서버 이미지(`apps/server/Dockerfile`)에 **core/ 파이썬 파이프라인**을 얹은 것.
# 왜 따로 두는가: `content.analyze` 는 `python -m core.analyze` 를 스폰하므로 core/ 와
# 파이썬 의존성이 필요한데, 그걸 서버 이미지에 넣으면 **API 서버까지 ~500MB 무거워지고**
# 콜드 스타트가 느려진다. 서버는 core/ 를 실행하지 않는다.
#
# ⚠️ GPU 는 없다. 그래서 이 이미지에서는:
#   · `STT_PROVIDER=soniox` 여야 한다 (hybrid/whisper 는 torch+CUDA 필요 · 회차당 +₩270)
#   · `RUN_FACES` 는 꺼진 채로 둔다 (InSightFace = GPU)
#   · `gebd.detect` 는 이 lane 에서 안 돈다 (WORKER_JOBS 로 분리)
#
# 빌드: gcloud builds submit --config=deploy/cloudbuild-worker.yaml \
#         --substitutions=_TAG=…,_DOCKERFILE=apps/server/Dockerfile.worker .

FROM node:22-bookworm-slim AS base

# ffmpeg — core/ 가 프레임·오디오 추출에 쓴다. fonts-noto-cjk 는 자막 번인용.
# python3-venv 는 아래 venv 생성에 필요하다 (slim 이미지엔 없다).
# libgl1·libglib2.0-0·libsm6·libxext6·libxrender1 = opencv 런타임.
# libegl1·libgles2 = MediaPipe 0.10.x 의 C 바인딩이 dlopen 하는 GLESv2/EGL — 없으면
#   FaceDetector.create_from_options 가 `libGLESv2.so.2: cannot open` 로 죽는다(리프레임 전용).
#   빌드 타임 detector 스모크(아래)가 이걸 강제한다 — 지우지 말 것.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    fonts-noto-cjk \
    fontconfig \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libegl1 \
    libgles2 \
    python3 \
    python3-venv \
    python3-dev \
    make \
    g++ \
    curl \
    unzip \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# deno — yt-dlp 신버전의 유튜브 추출은 JS 챌린지(nsig) 해석에 JS 런타임을 요구한다.
# 없으면 "without a JS runtime has been deprecated" 경고와 함께 포맷 누락·봇 판정이 잦다
# (2026-08-14 실측). yt-dlp 가 PATH 의 deno 를 자동 감지한다.
RUN curl -fsSL https://github.com/denoland/deno/releases/latest/download/deno-x86_64-unknown-linux-gnu.zip -o /tmp/deno.zip \
 && unzip -o /tmp/deno.zip -d /usr/local/bin \
 && rm /tmp/deno.zip \
 && chmod +x /usr/local/bin/deno \
 && /usr/local/bin/deno --version

ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
# ⚠️ **버전을 못박는다.** `pnpm@latest` 였는데, pnpm 12 가 나온 날 빌드가 통째로 깨졌다
# (2026-09-07: `pnpm rebuild esbuild` 가 ERR_PNPM_IGNORED_BUILDS 로 거절 — 12 부터
# 빌드 스크립트를 명시 승인해야 한다). 이미지가 오늘 npm 에 뭐가 올라왔는지에 따라
# 달라지면 그건 빌드가 아니라 복권이다. 리포가 선언한 값(package.json packageManager)과
# 같은 버전을 쓴다 — 올릴 때는 두 곳을 같이 올릴 것.
RUN npm install -g pnpm@10.33.2

# ── node deps (캐시) ─────────────────────────────────────────────────────────
# ⚠️ **lockfile 로 깐다** — 이유는 `apps/server/Dockerfile` 의 같은 자리 주석에 길게 적었다.
# 요약: 예전엔 pnpm-lock.yaml 을 복사조차 안 하고 `--no-frozen-lockfile` 로 깔아서,
# `^` 범위 16개가 빌드하는 날의 최신으로 풀렸다(= CI 가 검증한 트리 ≠ 배포되는 트리).
# 워크스페이스 package.json 5개를 다 복사하는 것도 같은 이유다(lockfile importer 대조).
FROM base AS deps
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY admin/package.json admin/
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
COPY native/package.json native/
RUN pnpm install --frozen-lockfile --filter @stepd/server --ignore-scripts \
 && pnpm rebuild --filter @stepd/server esbuild

# ── python deps (캐시) ───────────────────────────────────────────────────────
# requirements 만 먼저 복사해 레이어를 캐시한다 — core/ 소스가 바뀌어도 재설치 안 하도록.
#
# ⚠️ **`requirements.txt` 가 아니라 `requirements.lock.txt` 로 깐다.** 전자는 사람이 읽는
# 직접 선언분이고, 후자가 전이 의존성까지 고정한 재현용 목록이다. 2026-09-11 이전엔 전자로
# 깔았고 mediapipe 빼고 전부 `>=` 였다 — 같은 커밋을 다시 빌드해도 opencv·rembg·google-genai
# 가 달라졌다는 뜻이다(node 쪽 lockfile 을 안 쓰던 것과 정확히 같은 문제).
#
# pip 자체도 못박는다. 위 pnpm 과 같은 이유다 — 도구가 오늘 뭐가 올라왔느냐로 바뀌면
# 그건 빌드가 아니다. (pip 26.2.1 = 프로덕션 워커 이미지 실측값)
#
# yt-dlp 는 lock 에 들어 있다(youtube.download 잡의 필수 바이너리 · 없으면 유튜브 가져오기가
# 전건 실패한다 — 2026-08-14 실측). 아래 ENV YT_DLP 가 이 venv 안의 경로를 고정한다.
FROM base AS pydeps
COPY core/requirements.lock.txt /tmp/requirements.lock.txt
RUN python3 -m venv /opt/corevenv \
 && /opt/corevenv/bin/pip install --no-cache-dir --upgrade "pip==26.2.1" \
 && /opt/corevenv/bin/pip install --no-cache-dir -r /tmp/requirements.lock.txt \
 && /opt/corevenv/bin/python -c "\
import cv2, sys; \
v = cv2.__version__; \
sys.exit('cv2 가 %s 다 — OpenCV 5 는 아직 준비 안 됐다(requirements.txt 주석 참조)' % v) if not v.startswith('4.') else None; \
sys.exit('cv2 에 contrib 모듈(ximgproc)이 없다 — opencv-python 이 contrib 를 덮어썼다') if not hasattr(cv2, 'ximgproc') else None; \
print('cv2 smoke: ok (%s, contrib)' % v)" \
 && /opt/corevenv/bin/yt-dlp --version > /dev/null && echo "yt-dlp smoke: ok"

# ── runtime ─────────────────────────────────────────────────────────────────
FROM base AS runtime
WORKDIR /app
COPY package.json ./
COPY apps/server apps/server
COPY core core
# ⚠️ **두 줄이 세트다.** pnpm 워크스페이스는 패키지 실물을 `/app/node_modules/.pnpm` 에 두고
# 앱 폴더엔 상대 심링크만 남긴다 — 하나만 복사하면 런타임에 MODULE_NOT_FOUND 로 죽는다.
COPY --from=deps /app/node_modules /app/node_modules
COPY --from=deps /app/apps/server/node_modules /app/apps/server/node_modules
COPY --from=pydeps /opt/corevenv /opt/corevenv
# MediaPipe's model is intentionally not committed. The downloader verifies the pinned
# upstream SHA-256, so a missing/corrupt model fails the image build instead of every job.
RUN mkdir -p /opt/reframe-models \
 && /opt/corevenv/bin/python -m core.reframe.download_model \
      --output /opt/reframe-models/blaze_face_full_range.tflite \
 && REFRAME_FACE_MODEL=/opt/reframe-models/blaze_face_full_range.tflite \
      /opt/corevenv/bin/python -c \
      "import cv2, mediapipe; from core.reframe.video import resolve_model_path, _mediapipe_detector; _, detector = _mediapipe_detector(resolve_model_path()); detector.close(); print('reframe detector smoke: ok')"
# 렌더 폰트 — 서버 Dockerfile 과 동일 (Pretendard, ASS Fontname 매칭)
COPY assets/fonts /usr/share/fonts/opentype/pretendard
RUN fc-cache -f
# canvas 정적 오버레이 PNG 렌더(overlay-canvas.ts)의 리포 상대경로 폰트 — 서버 Dockerfile 과 동일.
COPY assets/fonts assets/fonts
# 인보이스 PDF 폰트 — content 워커도 분석 후 자동충전(maybeAutoTopup)에서 결제·메일을 보낸다.
COPY assets/invoice-fonts assets/invoice-fonts

ENV NODE_ENV=production
# content-pipeline.ts 가 이 값으로 파이썬을 스폰한다. 지정 안 하면 리포 안 venv 를 찾다가
# 없으면 시스템 파이썬으로 폴백해 의존성 없이 죽는다.
ENV CORE_PYTHON=/opt/corevenv/bin/python
ENV CORE_DIR=/app
# yt-dlp 는 corevenv 에 설치된다(위 pydeps 스테이지) — PATH 의존 대신 경로를 고정한다.
ENV YT_DLP=/opt/corevenv/bin/yt-dlp
ENV REFRAME_FACE_MODEL=/opt/reframe-models/blaze_face_full_range.tflite

WORKDIR /app/apps/server
CMD ["npx", "tsx", "src/worker.ts", "--drain"]
